# LAMMPS input script for solidification of nano-polycrystalline aluminum with separate dump files and temperature logging

# Set variables
variable dt equal 4 # time step size in fs
variable Neq equal 2000 # number of equilibration steps
variable Nprod equal 10000 # number of production steps
variable Teq equal ${EstTemp} # equilibration temperature
variable pressBar equal ${DefPress}        # pressure in bar
variable Peq equal $(v_pressBar * 9869) # pressure from bar to atmospheres
variable Nrep equal 10 # number of unit cell repetitions in each direction


print "Running simulation with the following parameters:"
print "Temperature: ${Teq} K"
print "Pressure: ${pressBar} bar"

units           real
atom_style      atomic
boundary        p p p


# The HCP lattice is cubic

lattice         hcp 2.94 # Titanium
region          box block 0 $(2*v_Nrep) 0 ${Nrep} 0 ${Nrep} units lattice
create_box      1 box
create_atoms    1 box

mass            1 47.87 # Titanium

write_data ${folderpath}/hcp_prepared_P_${DefPress}_T_${Teq}.lmpdat


comm_modify     mode single cutoff 17.0
pair_style          chemtrain_deploy cuda12 0.95
pair_coeff          * * ../models/${model}/model.ptb 1.5 1.25

# Set neighbor communication
neighbor            2.0 bin
neigh_modify    delay 0 every 1 check yes

# Minimize the system
minimize            1.0e-5 1.0e-5 10000 100000

# Run equilibration
reset_timestep  0

thermo              100
thermo_style        custom step temp pe etotal press vol
thermo_modify       flush yes

timestep            ${dt}

velocity        all create ${Teq} 23456789
fix             f1 all nph &
                x ${Peq} ${Peq} $(1000.*dt) &
                y ${Peq} ${Peq} $(1000.*dt) &
                z ${Peq} ${Peq} $(1000.*dt) &
                couple xy pchain 2
fix             f2 all langevin ${Teq} ${Teq} 100. 23456789 zero yes
compute         1 all msd com yes

variable        temp equal temp
variable        press equal press
variable        vol equal vol
variable        pe equal pe
variable        msd equal c_1[4]
variable        a equal "lx/(2*v_Nrep)" # Compute the lattice constants
variable        c equal "lz/(v_Nrep)" # Compute the lattice constants
variable        ca equal "v_c/v_a"

fix             2 all print 10 "${temp},${press},${vol},${pe},${a},${c},${ca},${msd}" title "T, P, V" file ${folderpath}/hcp_eq_P_${DefPress}_T_${Teq}.csv screen no

run ${Neq} # Run short equilibration to get the right temperature and density

fix             2 all print 10 "${temp},${press},${vol},${pe},${a},${c},${ca},${msd}" title "T, P, V" file ${folderpath}/hcp_equilibrated_P_${DefPress}_T_${Teq}.csv screen no

# Output data for post-simulation analysis
dump            all_sim all atom 100 ${folderpath}/dump_hcp_P_${DefPress}_T_${Teq}.lammpstrj  # Saves the entire simulation
run ${Nprod} # Run short equilibration to get the right temperature

write_data ${folderpath}/hcp_equilibrated_P_${DefPress}_T_${Teq}.lmpdat
