
units real                     # Angstroms, picoseconds, eV, Kelvin, bars
dimension 3
boundary p p p
atom_style atomic


lattice hcp ${a}
region box block 0 9 0 4 0 4
create_box 1 box
create_atoms 1 box

mass            1 47.87 # Titanium

# Scale to correct c/a (default is c/a=sqrt(3)/8)
change_box      all z scale $(v_ca*sqrt(3/8)) remap

mass            1 47.94794068 # Ti

write_data ${folderpath}/hcp_box_T_${T}_P_${P}_a_${a}_ca_${ca}.lmpdat